SYSTEM_TIMEZONE=Africa/Addis_Ababa

PORT=4001
JWT_SECRET=mims-prod-jwt-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_EXPIRATION_TIME=12h

DB_USER=mims_user
DB_PASSWORD=mims@mom.gov.et
DB_NAME=mims_db
DB_HOST=postgres
DB_PORT=5432
DB_DIALECT=postgres

# Public URLs (through nginx, HTTPS)
FRONTEND_URL=https://inspection.mom.gov.et
BASE_URL=https://inspection.mom.gov.et/api

EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER="momsystemsupport@gmail.com"
EMAIL_PASS="your-gmail-app-password"
EMAIL_FROM=Mining Inspection Management System <momsystemsupport@gmail.com>
APP_NAME=Mining Inspection Management System

SMPP_HOST=
SMPP_PORT=
SMPP_SYSTEM_ID=
SMPP_PASSWORD=
SMPP_SOURCE_ADDR=

ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
REFRESH_TOKEN_BYTES=64

# Local development only: let `npm run seed` create the inspectors from the license
# list with the password "password". Leave unset (or false) on any server.
# SEED_DEV_PASSWORDS=true
# Domain for generated inspector emails (reserved example domain by default)
# SEED_USER_EMAIL_DOMAIN=gmail.com
