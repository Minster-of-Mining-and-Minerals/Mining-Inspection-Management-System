# SSR fallbacks only — browser API uses window.location.origin/api at runtime
NEXT_PUBLIC_SYSTEM_TIMEZONE=Africa/Addis_Ababa

# Optional SSR fallbacks (not used for browser API calls after runtime URL fix)
# NEXT_PUBLIC_BASE_URL=https://inspection.mom.gov.et/api
# NEXT_PUBLIC_FILE_URL=https://inspection.mom.gov.et
# NEXT_PUBLIC_FRONTEND_URL=https://inspection.mom.gov.et

# NextAuth — use the IP/host users actually open in the browser
NEXTAUTH_URL=https://inspection.mom.gov.et
NEXTAUTH_SECRET=mims-prod-nextauth-change-this-to-32plus-random-chars
AUTH_SECRET=mims-prod-nextauth-change-this-to-32plus-random-chars
NEXTAUTH_TRUST_HOST=true
AUTH_TRUSTED_HOST=true

# Docker internal only — server-side login from Next.js container
BACKEND_INTERNAL_URL=http://backend:4001
