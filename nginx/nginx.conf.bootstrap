# HTTP only: used until the certificate exists (direct mode), or always when another web server
# in front does HTTPS (behind-proxy mode). Keep the scheme that server reports.
map $http_x_forwarded_proto $mims_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 100M;

    # Let's Encrypt checks this path to issue the first certificate
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location ~ ^/api/auth/(session|csrf|providers|callback|signout|signin|_log) {
        proxy_pass http://frontend:3001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $mims_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /api {
        proxy_pass http://backend:4001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $mims_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    location /uploads {
        proxy_pass http://backend:4001/uploads;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $mims_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    location / {
        proxy_pass http://frontend:3001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $mims_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
