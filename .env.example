# Settings used by docker-compose.yml itself. deploy.sh creates .env from this on the first run.
DOMAIN=inspection.mom.gov.et
# Let's Encrypt sends certificate expiry notices here
EMAIL=admin@mom.gov.et

NEXT_PUBLIC_SYSTEM_TIMEZONE=Africa/Addis_Ababa

# Database (used by both the database and the backend). Do not change DB_PASSWORD after
# the first start: the database keeps the password it was created with.
DB_NAME=mims_db
DB_USER=mims_user
DB_PASSWORD=change-me

# direct: MIMS uses ports 80/443 and gets its own certificate.
# behind_proxy: another web server on this machine already has 80/443 and does HTTPS;
#   it forwards inspection.mom.gov.et to MIMS on HTTP_PORT (see DEPLOYMENT.md).
MIMS_MODE=direct
# HTTP_PORT=8081
# HTTPS_PORT=8444

# Who can reach the frontend (3001) and backend (4001, 5001) directly:
# 127.0.0.1 = only this server; 0.0.0.0 = every network (open the firewall too)
# BIND_IP=127.0.0.1
